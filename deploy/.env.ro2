# .env.ro2
# === Read-Only режим, реплика 2 ===

DATABASE_URL=postgresql://readonly:readonly_pass@postgres-slave:5432/quickflow_db
REDIS_URL=redis:6379
REDIS_PASS=22848Amogus

DOMAIN=localhost

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=adminpassword
MINIO_POSTS_BUCKET_NAME=posts
MINIO_PROFILE_BUCKET_NAME=profile-images
MINIO_ATTACHMENTS_BUCKET_NAME=attachments
MINIO_STICKERS_BUCKET_NAME=stickers
MINIO_INTERNAL_ENDPOINT=minio:9000

# === Имена и порты (реплика 2) ===
GATEWAY_NAME=gateway-ro2
FILE_SERVICE_NAME=file_service-ro2
POST_SERVICE_NAME=post_service-ro2
USER_SERVICE_NAME=user_service-ro2
MESSENGER_SERVICE_NAME=messenger_service-ro2
FEEDBACK_SERVICE_NAME=feedback_service-ro2
FRIENDS_SERVICE_NAME=friends_service-ro2
COMMUNITY_SERVICE_NAME=community_service-ro2

GATEWAY_PORT=8060
FILE_SERVICE_PORT=8061
POST_SERVICE_PORT=8062
USER_SERVICE_PORT=8063
MESSENGER_SERVICE_PORT=8064
FEEDBACK_SERVICE_PORT=8065
FRIENDS_SERVICE_PORT=8066
COMMUNITY_SERVICE_PORT=8067

# === GRPC адреса ===
FILE_SERVICE_ADDR=file_service-ro2:8061
POST_SERVICE_ADDR=post_service-ro2:8062
USER_SERVICE_ADDR=user_service-ro2:8063
MESSENGER_SERVICE_ADDR=messenger_service-ro2:8064
FEEDBACK_SERVICE_ADDR=feedback_service-ro2:8065
FRIENDS_SERVICE_ADDR=friends_service-ro2:8066
COMMUNITY_SERVICE_ADDR=community_service-ro2:8067

RUNNING_IN_CONTAINER=true
SERVICE_MODE=ro
