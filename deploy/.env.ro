# .env.ro — Read-Only режим для всех сервисов

# === Database & Redis ===
# Используем пользователя только для чтения
DATABASE_URL=postgresql://readonly:readonly_pass@postgres:5432/quickflow_db
REDIS_URL=redis:6379
REDIS_PASS=22848Amogus

# === Domain ===
DOMAIN=localhost

# === Minio ===
# MinIO — read-only режим не нужен, сервисы всё ещё могут писать в S3
# Но если хочешь — можно создать отдельного пользователя с limited policy
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=adminpassword
MINIO_POSTS_BUCKET_NAME=posts
MINIO_PROFILE_BUCKET_NAME=profile-images
MINIO_ATTACHMENTS_BUCKET_NAME=attachments
MINIO_STICKERS_BUCKET_NAME=stickers
MINIO_INTERNAL_ENDPOINT=minio:9000

# === Internal Microservice GRPC addresses ===
# Оставляем как есть — адреса не меняются
FILE_SERVICE_ADDR=file_service:8081
POST_SERVICE_ADDR=post_service:8082
USER_SERVICE_ADDR=user_service:8083
MESSENGER_SERVICE_ADDR=messenger_service:8084
FEEDBACK_SERVICE_ADDR=feedback_service:8085
FRIENDS_SERVICE_ADDR=friends_service:8086
COMMUNITY_SERVICE_ADDR=community_service:8087

# === Режим ===
RUNNING_IN_CONTAINER=true
SERVICE_MODE=ro  # можно использовать в коде для логирования
