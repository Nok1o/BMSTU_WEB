# .env.ro1
# === Read-Only режим, реплика 1 ===

# === Database & Redis ===
DATABASE_URL=postgresql://readonly:readonly_pass@postgres-slave:5432/quickflow_db
REDIS_URL=redis:6379
REDIS_PASS=22848Amogus

# === Domain ===
DOMAIN=localhost

# === Minio ===
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=adminpassword
MINIO_POSTS_BUCKET_NAME=posts
MINIO_PROFILE_BUCKET_NAME=profile-images
MINIO_ATTACHMENTS_BUCKET_NAME=attachments
MINIO_STICKERS_BUCKET_NAME=stickers
MINIO_INTERNAL_ENDPOINT=minio:9000

# === Сервисные имена и порты (реплика 1) ===
GATEWAY_NAME=gateway-ro1
FILE_SERVICE_NAME=file_service-ro1
POST_SERVICE_NAME=post_service-ro1
USER_SERVICE_NAME=user_service-ro1
MESSENGER_SERVICE_NAME=messenger_service-ro1
FEEDBACK_SERVICE_NAME=feedback_service-ro1
FRIENDS_SERVICE_NAME=friends_service-ro1
COMMUNITY_SERVICE_NAME=community_service-ro1

GATEWAY_PORT=8070
FILE_SERVICE_PORT=8071
POST_SERVICE_PORT=8072
USER_SERVICE_PORT=8073
MESSENGER_SERVICE_PORT=8074
FEEDBACK_SERVICE_PORT=8075
FRIENDS_SERVICE_PORT=8076
COMMUNITY_SERVICE_PORT=8077

# === GRPC адреса — указывают на свои порты ===
FILE_SERVICE_ADDR=file_service-ro1:8070
POST_SERVICE_ADDR=post_service-ro1:8072
USER_SERVICE_ADDR=user_service-ro1:8073
MESSENGER_SERVICE_ADDR=messenger_service-ro1:8074
FEEDBACK_SERVICE_ADDR=feedback_service-ro1:8075
FRIENDS_SERVICE_ADDR=friends_service-ro1:8076
COMMUNITY_SERVICE_ADDR=community_service-ro1:8077

RUNNING_IN_CONTAINER=true
SERVICE_MODE=ro
